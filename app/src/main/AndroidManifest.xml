                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.z" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.lzma" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.lz4" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.br" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.lzip" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.iso" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.cab" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.deb" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.rpm" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.dmg" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.wim" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.chm" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.cpio" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.zip.*" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.z..*" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.jar" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.apk" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.7z.*" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.rar.*" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.r.." />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.part.*\.rar" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.tar" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.gz" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.bz2" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.xz" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.zst" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.zstd" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.z" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.lzma" />
                <data android:scheme="file" android:mimeType="application/octet-stream" android:pathPattern=".*\.lz4" />
