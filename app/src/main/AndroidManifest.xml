                <data android:scheme="content" android:mimeType="application/x-cab" />
                <data android:scheme="content" android:mimeType="application/x-deb" />
                <data android:scheme="content" android:mimeType="application/x-redhat-package-manager" />
                <data android:scheme="content" android:mimeType="application/x-rpm" />
                <data android:scheme="content" android:mimeType="application/x-ms-wim" />
                <data android:scheme="content" android:mimeType="application/vnd.ms-htmlhelp" />
                <data android:scheme="content" android:mimeType="application/x-cpio" />
