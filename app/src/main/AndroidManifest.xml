                <data android:scheme="file" android:mimeType="application/x-xz" />
                <data android:scheme="file" android:mimeType="application/x-lzma" />
                <data android:scheme="file" android:mimeType="application/x-lz4" />
                <data android:scheme="file" android:mimeType="application/x-lzip" />
                <data android:scheme="file" android:mimeType="application/x-brotli" />
                <data android:scheme="file" android:mimeType="application/x-apple-diskimage" />
                <data android:scheme="file" android:mimeType="application/vnd.ms-cab-compressed" />
                <data android:scheme="file" android:mimeType="application/x-cab" />
                <data android:scheme="file" android:mimeType="application/x-deb" />
                <data android:scheme="file" android:mimeType="application/x-redhat-package-manager" />
                <data android:scheme="file" android:mimeType="application/x-rpm" />
                <data android:scheme="file" android:mimeType="application/x-ms-wim" />
                <data android:scheme="file" android:mimeType="application/vnd.ms-htmlhelp" />
                <data android:scheme="file" android:mimeType="application/x-cpio" />
                <data android:scheme="file" android:mimeType="application/x-gtar" />
                <data android:scheme="file" android:mimeType="application/x-gtar-compressed" />
                <data android:scheme="file" android:mimeType="application/x-java-archive" />
                <data android:scheme="file" android:mimeType="application/x-zip-compressed" />
                <data android:scheme="file" android:mimeType="application/x-iso9660-image" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.zip.*" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.z..*" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.jar" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.apk" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.7z.*" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.rar.*" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.r.." />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.part.*\.rar" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.tar" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\.gz" />
