<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/rv_screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rv_section_spacing"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_container"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vc_add_container" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/catalog_status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rv_section_spacing"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/rv_card_radius"
        app:strokeColor="@color/rv_outline_subtle"
        app:strokeWidth="1dp"
        app:cardUseCompatPadding="true">

        <TextView
            android:id="@+id/catalog_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/rv_card_padding"
            android:textColor="@color/rv_on_surface" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/container_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/rv_section_spacing"
        android:layout_weight="1"
        android:background="@drawable/rv_catalog_frame"
        android:clipToPadding="false"
        android:padding="8dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/empty_catalog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/rv_card_radius"
        app:strokeColor="@color/rv_outline_subtle"
        app:strokeWidth="1dp"
        app:cardUseCompatPadding="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/rv_card_padding"
            android:text="@string/vc_catalog_empty"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
