<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/paneLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?colorSurface">

    <LinearLayout
        android:id="@+id/paneHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:background="?colorSurfaceContainerLow"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/paneLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?textAppearanceLabelMedium"
                android:textColor="?colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/paneCurrentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/file_list_pane_current"
                android:textAppearance="?textAppearanceLabelSmall"
                android:textColor="?colorOnPrimaryContainer"
                android:background="@drawable/dual_pane_badge" />

            <TextView
                android:id="@+id/paneSelectedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_weight="1"
                android:gravity="end"
                android:textAppearance="?textAppearanceLabelSmall"
                android:textColor="?colorPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/panePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="?textAppearanceTitleSmall"
            android:textColor="?colorOnSurface"
            android:fontFamily="monospace" />

        <me.zhanghai.android.files.filelist.BreadcrumbLayout
            android:id="@+id/paneBreadcrumb"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_layout_height"
            android:visibility="visible" />

        <TextView
            android:id="@+id/paneSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?textAppearanceBodySmall"
            android:textColor="?colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/paneParentRow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="?selectableItemBackground"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/file_list_parent_directory">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/directory_icon_white_24dp"
            android:tint="?colorControlNormal"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/paneParentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=".."
            android:textAppearance="?textAppearanceListItem"
            android:textSize="16sp"
            android:textColor="?colorOnSurface" />
    </LinearLayout>

    <me.zhanghai.android.files.ui.CoordinatorScrollingFrameLayout
        android:id="@+id/paneContentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/paneProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/paneEmptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/file_icon_240dp"
                android:tint="?colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/file_list_pane_empty_message"
                android:textAppearance="?textAppearanceTitleSmall"
                android:textColor="?colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/file_list_pane_empty_hint"
                android:textAppearance="?textAppearanceBodySmall"
                android:textColor="?colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/paneErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textAppearance="?textAppearanceBodyMedium"
            android:textColor="?colorError"
            android:visibility="gone" />

        <androidx.swiperefreshlayout.widget.ThemedSwipeRefreshLayout
            android:id="@+id/paneSwipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/paneRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                tools:listitem="@layout/file_item_list" />
        </androidx.swiperefreshlayout.widget.ThemedSwipeRefreshLayout>
    </me.zhanghai.android.files.ui.CoordinatorScrollingFrameLayout>
</LinearLayout>
