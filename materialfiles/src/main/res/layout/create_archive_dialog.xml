<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/abc_dialog_title_divider_material">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        android:scrollIndicators="top|bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/name_dialog_name_include" />

            <TextView
                android:id="@+id/targetPathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="?dialogPreferredPadding"
                android:layout_marginEnd="?dialogPreferredPadding"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="?textAppearanceBodySmall" />

            <me.zhanghai.android.files.filelist.CreateArchiveTypeRadioGroup
                android:id="@+id/typeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="@dimen/dialog_padding_minus_6dp"
                android:paddingEnd="@dimen/dialog_padding"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/zipRadio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dense_single_line_list_item_height"
                    android:layout_weight="1"
                    android:text="@string/file_create_archive_type_zip"
                    android:textAppearance="?textAppearanceListItem" />

                <RadioButton
                    android:id="@+id/tarXzRadio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dense_single_line_list_item_height"
                    android:layout_weight="1"
                    android:text="@string/file_create_archive_type_tar_xz"
                    android:textAppearance="?textAppearanceListItem" />

                <RadioButton
                    android:id="@+id/sevenZRadio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dense_single_line_list_item_height"
                    android:layout_weight="1"
                    android:text="@string/file_create_archive_type_7z"
                    android:textAppearance="?textAppearanceListItem"
                    android:visibility="@integer/create_archive_type_seven_z_visibility" />
            </me.zhanghai.android.files.filelist.CreateArchiveTypeRadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="?dialogPreferredPadding"
                android:layout_marginEnd="?dialogPreferredPadding"
                android:layout_marginTop="4dp"
                android:hint="@string/file_create_archive_password"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordConfirmLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="?dialogPreferredPadding"
                android:layout_marginEnd="?dialogPreferredPadding"
                android:hint="@string/file_create_archive_password_confirm"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordConfirmEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/advancedButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?dialogPreferredPadding"
                android:text="@string/file_create_archive_advanced" />

            <LinearLayout
                android:id="@+id/advancedLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="?dialogPreferredPadding"
                android:paddingEnd="?dialogPreferredPadding"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/file_create_archive_compression" />

                <Spinner
                    android:id="@+id/compressionSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/compressionLevelLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/file_create_archive_compression_level" />

                <Spinner
                    android:id="@+id/compressionLevelSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/sevenZLevelLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/file_create_archive_compression_level"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/sevenZLevelSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/zipEncryptionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/file_create_archive_encryption" />

                <Spinner
                    android:id="@+id/encryptionSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/encryptionWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/file_create_archive_legacy_encryption_warning"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/zipFilenameWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/file_create_archive_zip_filename_visible"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sevenZEncryptionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/file_create_archive_encryption"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/sevenZEncryptionSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <CheckBox
                    android:id="@+id/sevenZEncryptHeadersCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/file_create_archive_encrypt_filenames"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/tarCompressionSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tarZstdLevelLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/file_create_archive_compression_level"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/tarZstdLevelSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/splitSizeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/file_create_archive_split_size">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/splitSizeEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sevenZThreadLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/file_create_archive_7z_threads">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sevenZThreadEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/sevenZSolidCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/file_create_archive_7z_solid" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
